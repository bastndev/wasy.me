---
// 404.astro - Modern 404 page with square lines and black theme
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>
</head>
<body>
    <main class="error-container">
        <div class="error-grid">
            <div class="error-box header">
                <h1 class="number">404</h1>
            </div>
            <div class="error-box message">
                <p>Page not found</p>
            </div>
            <div class="error-box description">
                <p>The page you are looking for doesn't exist or has been moved.</p>
            </div>
            <div class="error-box action">
                <a href="/">Return Home</a>
            </div>
        </div>
    </main>
</body>
</html>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    :root {
        --bg-color-1: #0a0a0a;  
        --bg-color-2: #121212;  
        --bg-color-3: #1a1a22;  
        --text-color: #fff;    
        --border-color: #555;  
    }

    html, body {
        height: 100%;
        background: linear-gradient(135deg, var(--bg-color-1) 0%, var(--bg-color-2) 50%, var(--bg-color-3) 100%);
        color: var(--text-color);
        font-family: system-ui, sans-serif;
    }

    .error-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1.5rem;
    }

    .error-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        max-width: 600px;
        width: 100%;
        backdrop-filter: blur(5px);
    }

    .error-box {
        border: 2px solid var(--border-color);
        padding: 1.5rem;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: transform 0.3s ease;
        background-color: rgba(0, 0, 0, 0.3);
    }

    .error-box:hover {
        transform: translateY(-5px);
    }
    .number {
        animation: moveUpDown 2s infinite ease-in-out;
    }

    @keyframes moveUpDown {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }

    h1 {
        font-size: 8rem;
        font-weight: 700;
        letter-spacing: -5px;
    }

    .message p {
        font-size: 2rem;
        text-transform: uppercase;
        letter-spacing: 3px;
    }

    .description p {
        text-align: center;
        opacity: 0.7;
    }

    .action a {
        color: var(--text-color);
        text-decoration: none;
        border: 1px solid var(--text-color);
        padding: 0.75rem 2rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .action a:hover {
        background-color: var(--text-color);
        color: var(--bg-color-1);
    }

    @media (min-width: 768px) {
        .error-grid {
            grid-template-columns: 1fr 1fr;
        }
        
        .header {
            grid-column: 1 / 2;
            grid-row: 1 / 3;
        }
        
        .message {
            grid-column: 2 / 3;
            grid-row: 1 / 2;
        }
        
        .description {
            grid-column: 2 / 3;
            grid-row: 2 / 3;
        }
        
        .action {
            grid-column: 1 / -1;
        }
    }
</style>